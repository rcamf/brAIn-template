filters:
  and:
    - file.hasTag("session")

properties:
  note.repo:
    displayName: Repo
  note.branch:
    displayName: Branch
  note.started:
    displayName: Started

views:
  - type: table
    name: All sessions
    order:
      - file.name
      - note.repo
      - note.branch
      - note.started
  - type: table
    name: Active
    filters:
      and:
        - '!file.inFolder("sessions/archive")'
    order:
      - file.name
      - note.repo
      - note.branch
      - note.started
